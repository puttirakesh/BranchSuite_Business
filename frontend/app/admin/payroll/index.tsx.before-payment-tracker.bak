 gap: 6 }, stepCircle: { width: 25, height: 25, borderRadius: 13, alignItems: 'center', justifyContent: 'center', backgroundColor: '#e7edf7' }, activeStep: { backgroundColor: '#345cf2' }, stepNumber: { fontSize: 10, color: '#7a8ba5', fontWeight: '600' }, white: { color: '#fff' }, stepLabel: { fontSize: 9, color: '#607591' }, runCard: { padding: 20, borderRadius: 20, backgroundColor: '#eeedfc', borderWidth: 1, borderColor: '#e2e6fc', marginBottom: 16 }, runLabel: { fontSize: 9, fontWeight: '700', letterSpacing: 1, color: '#345cf2' }, statusBadge: { borderRadius: 6, paddingHorizontal: 8, paddingVertical: 4, backgroundColor: '#fff1d9' }, net: { fontSize: 32, fontWeight: '800', color: '#20334f', marginTop: 16 }, grid: { flexDirection: 'row', flexWrap: 'wrap', gap: 12, marginBottom: 16 }, metric: { width: '46%', flexGrow: 1, padding: 14, backgroundColor: '#fff', borderWidth: 1, borderColor: '#e0e8f5', borderRadius: 16 }, metricLabel: { fontSize: 10, color: '#607591' }, metricValue: { fontSize: 22, fontWeight: '800', color: '#20334f', marginVertical: 7 }, workspace: { width: '46%', flexGrow: 1, borderWidth: 1, borderColor: '#e0e8f5', borderRadius: 18, backgroundColor: '#fff', overflow: 'hidden' }, workspaceBody: { padding: 14, minHeight: 144 }, icon: { width: 36, height: 36, borderRadius: 12, justifyContent: 'center', alignItems: 'center' }, glyph: { fontSize: 23 }, countBadge: { borderRadius: 7, paddingHorizontal: 8, paddingVertical: 5, backgroundColor: '#f2f5fc' }, workspaceTitle: { fontSize: 13, fontWeight: '700', color: '#20334f', marginTop: 14 }, workspaceFooter: { minHeight: 36, paddingHorizontal: 14, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', borderTopWidth: 1, borderTopColor: '#f0f3f9', backgroundColor: '#fcfdff' }, submit: { minHeight: 46, borderRadius: 13, backgroundColor: '#345cf2', alignItems: 'center', justifyContent: 'center', paddingHorizontal: 12 }, submitText: { fontSize: 12, fontWeight: '700', color: '#fff' }, dim: { opacity: 0.5 }, notice: { marginTop: 12, fontSize: 12, color: '#34856c' }, error: { marginTop: 12, fontSize: 12, color: '#b94d61' }, errorBox: { padding: 14, borderRadius: 13, backgroundColor: '#fff', marginBottom: 12 }, navigation: { flexDirection: 'row', paddingVertical: 8, backgroundColor: '#fff', borderTopWidth: 1, borderTopColor: '#e4eaf5' }, navItem: { flex: 1, alignItems: 'center', gap: 3 }, navIcon: { width: 46, height: 32, borderRadius: 13, alignItems: 'center', justifyContent: 'center' }, navGlyph: { fontSize: 22, color: '#71829c' }, navLabel: { fontSize: 9, color: '#71829c' }, overlay: { flex: 1, padding: 24, justifyContent: 'center', backgroundColor: 'rgba(27,43,68,0.3)' }, modal: { padding: 22, width: '100%', maxWidth: 460, maxHeight: '85%', alignSelf: 'center', borderRadius: 20, backgroundColor: '#fff' }, modalTitle: { flex: 1, fontSize: 18, fontWeight: '700', color: '#20334f' }, close: { width: 38, height: 38, alignItems: 'center', justifyContent: 'center' }, option: { flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', paddingVertical: 17, borderBottomWidth: 1, borderBottomColor: '#edf1f8' }, detail: { paddingTop: 16 }, detailRow: { paddingVertical: 12, borderBottomWidth: 1, borderBottomColor: '#edf1f8' },
});

const incentiveStyles = StyleSheet.create({
  ...baseStyles,
  incentiveAvatar: { width: 34, height: 34, borderRadius: 12, backgroundColor: '#eaf0ff', alignItems: 'center', justifyContent: 'center' }, avatarInitial: { fontSize: 12, fontWeight: '700', color: '#345cf2' }, headerText: { fontSize: 10, color: '#20334f', flexShrink: 1 },
  incentiveHeading: { flexDirection: 'row', alignItems: 'flex-start', gap: 10, marginBottom: 22 }, incentiveBack: { width: 36, minHeight: 36, borderRadius: 10, borderWidth: 1, borderColor: '#e4eaf5', backgroundColor: '#fff', justifyContent: 'center', alignItems: 'center' }, backGlyph: { fontSize: 24, color: '#20334f' },
  incentiveInfo: { flexDirection: 'row', gap: 10, padding: 14, backgroundColor: '#eaf0ff', borderRadius: 13, marginBottom: 14 }, incentiveInfoText: { fontSize: 11, lineHeight: 18, color: '#607591' },
  incentiveCard: { borderWidth: 1, borderColor: '#e4eaf5', backgroundColor: '#fff', borderRadius: 18, padding: 16, marginBottom: 14 }, incentiveBadge: { paddingHorizontal: 8, paddingVertical: 5, borderRadius: 6, backgroundColor: '#def6ef' }, pendingBadge: { backgroundColor: '#fff1db' }, incentiveBadgeText: { fontSize: 9, fontWeight: '600', color: '#405573' }, incentiveAmountRow: { flexDirection: 'row', justifyContent: 'space-between', gap: 12, marginTop: 16, marginBottom: 8 }, incentiveLabel: { fontSize: 12, color: '#20334f' },
  pipelineButton: { minHeight: 44, borderRadius: 13, backgroundColor: '#eaf0ff', alignItems: 'center', justifyContent: 'center', marginTop: 8 }, incentiveFooter: { fontSize: 9, color: '#8192ad', textAlign: 'center', marginTop: 32 },
});

const reviewStyles = StyleSheet.create({
  ...incentiveStyles,
  incentiveHeading: { ...incentiveStyles.incentiveHeading, marginBottom: 0 },
  csvButton: { minHeight: 40, paddingHorizontal: 14, borderWidth: 1, borderColor: '#dce5f3', backgroundColor: '#fff', borderRadius: 12, alignItems: 'center', justifyContent: 'center' },
  reviewCard: { padding: 18, borderWidth: 1, borderColor: '#e4eaf5', backgroundColor: '#fff', borderRadius: 18, marginBottom: 14 }, reviewTitle: { fontSize: 17, fontWeight: '800', color: '#20334f', marginBottom: 6 }, reviewRow: { flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', gap: 14, paddingVertical: 14 }, reviewLabel: { fontSize: 12, color: '#20334f', flex: 1 }, reviewValue: { fontSize: 12, fontWeight: '700', color: '#20334f', flexShrink: 1 }, reviewTotal: { paddingHorizontal: 14, paddingVertical: 18, backgroundColor: '#eef7f4', borderRadius: 12, marginVertical: 8, flexWrap: 'wrap' }, reviewTotalText: { fontSize: 16, fontWeight: '800', color: '#138f80' },
  reconciled: { padding: 14, borderRadius: 13, backgroundColor: '#e6f4ee', marginBottom: 14 }, reconciledText: { fontSize: 11, color: '#34856c', lineHeight: 18 }, reviewDetails: { flexDirection: 'row', flexWrap: 'wrap', rowGap: 20, paddingVertical: 14 }, reviewDetail: { width: '50%', paddingRight: 12 }, fullDetail: { width: '100%' }, reviewDetailLabel: { fontSize: 9, color: '#71829c', marginBottom: 7, letterSpacing: 0.6 }, reviewDetailValue: { fontSize: 12, color: '#20334f', fontWeight: '600', lineHeight: 18 }, reviewSubmit: { marginBottom: 8 }, pdfButton: { minHeight: 44, borderWidth: 1, borderColor: '#dce5f3', backgroundColor: '#fff', borderRadius: 12, alignItems: 'center', justifyContent: 'center', marginTop: 18 },
});

const paymentStyles = StyleSheet.create({
  ...incentiveStyles,
