{
  "expo": {
    "name": "BranchSuite Business",
    "slug": "branchsuite-business",
    "scheme": "branchsuitebusiness",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "BranchSuite Business",
      "shortName": "BranchSuite",
      "themeColor": "#12112e"
    },
    "android": {
      "package": "com.branchsuite.business",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#12112e"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#12112e",
          "android": {
            "image": "./assets/adaptive-icon.png",
            "imageWidth": 200
          }
        }
      ],
      "expo-secure-store",
      "expo-sharing"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f2c9bc18-e150-4d22-b9ff-e651676e5553"
      }
    },
    "ios": {
      "bundleIdentifier": "com.branchsuite.business",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    }
  }
}
