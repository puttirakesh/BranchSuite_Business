    "@types/node": "^26.6.5",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --go --lan",
    "android": "expo start --go --lan --android",
    "android:lan": "expo start --go --lan --android",
    "ios": "expo start --go --lan --ios",
    "web": "expo start --go --lan --web",
    "lint": "npm run typecheck",
    "build:reference": "node docs/build-reference.cjs",
    "typecheck": "tsc --noEmit",
    "export:web": "npm run build:reference && expo export --platform web",
    "test": "node --test --test-isolation=none tests/auth/auth.test.ts tests/permissions/permissions.test.ts tests/customers/customers.test.ts tests/dashboard/dashboard.test.ts",
    "test:browser": "node docs/verify-app.cjs",
    "start:clean": "expo start --go --lan --clear",
    "start:tunnel": "expo start --go --tunnel ngrok",
    "prestart": "npm run build:reference",
    "preandroid": "npm run build:reference",
    "preweb": "npm run build:reference",
    "start:lan": "expo start --go --lan",
    "prestart:clean": "npm run build:reference"
  },
  "private": true
}
