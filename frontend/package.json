{
  "name": "branchsuite-business-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "branding:generate": "node scripts/generate-branding.cjs",
    "start": "expo start",
    "dev": "expo start",
    "web": "expo start --web",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "export:web": "expo export --platform web",
    "test:browser": "node --test --test-concurrency=1 tests/*.browser.cjs",
    "test:e2e": "npm run export:web && npm run test:browser"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@tanstack/react-query": "^5.0.0",
    "axios": "^1.0.0",
    "expo": "~57.0.31",
    "expo-blur": "~57.0.3",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.4",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-intent-launcher": "~57.0.1",
    "expo-linking": "~57.0.13",
    "expo-print": "~57.0.2",
    "expo-router": "~57.0.29",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.24",
    "expo-splash-screen": "~57.0.10",
    "jspdf": "^4.2.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-icons": "^5.7.0",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/react": "~19.2.4",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3"
  }
}
