# Razorpay Test Mode configuration. Replace each placeholder with values from
# the Razorpay Test Mode dashboard before enabling checkout/webhooks.
RAZORPAY_KEY_ID="rzp_test_TyQNQE6wfl5Wti"
RAZORPAY_KEY_SECRET="replace_with_test_mode_key_secret"
RAZORPAY_WEBHOOK_SECRET="replace_with_webhook_signing_secret"

# LEGACY (recurring Razorpay Subscriptions). Prepaid one-time Orders do NOT use
# these variables. They are only needed to keep historical subscription records
# explainable and can be removed once every legacy recurring subscription is
# cancelled/decommissioned (see the prepaid implementation report in docs/).
# Prices (paise) are fixed server-side in subscription-catalog.ts:
# Starter 99900 / 999000, Growth 249900 / 2499000, Scale 599900 / 5999000.
# RAZORPAY_PLAN_STARTER_MONTHLY=
# RAZORPAY_PLAN_STARTER_ANNUAL=
# RAZORPAY_PLAN_GROWTH_MONTHLY=
# RAZORPAY_PLAN_GROWTH_ANNUAL=
# RAZORPAY_PLAN_SCALE_MONTHLY=
# RAZORPAY_PLAN_SCALE_ANNUAL=

# Do not put RAZORPAY_KEY_SECRET or RAZORPAY_WEBHOOK_SECRET in Expo variables.
# Configure backend webhook URL:
# https://<backend-host>/api/v1/subscriptions/webhooks/razorpay
# Subscribe to: payment.authorized, payment.captured, payment.failed, order.paid.
# (subscription.* events are accepted and ignored: legacy recurring only.)

# Safety switches (see docs report, section 8/13):
# Refuse rzp_live_ keys even when NODE_ENV=production (set on the Render TESTING service).
RAZORPAY_ENFORCE_TEST_MODE=true
# Legacy only: allow tenants that have NO subscription row. Default (unset) is fail-closed.
# Never enable for new environments.
# ALLOW_LEGACY_TENANTS_WITHOUT_SUBSCRIPTION=true

# Public base of this API (including /api/v1) used to build the hosted checkout link
# for native apps. If unset it is derived from the request Host header.
# PUBLIC_API_BASE_URL=https://branchsuite-business-testing.onrender.com/api/v1
