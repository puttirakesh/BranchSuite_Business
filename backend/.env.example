# Razorpay Test Mode configuration. Replace each placeholder with values from
# the Razorpay Test Mode dashboard before enabling checkout/webhooks.
RAZORPAY_KEY_ID="rzp_test_TyQNQE6wfl5Wti"
RAZORPAY_KEY_SECRET="replace_with_test_mode_key_secret"
RAZORPAY_WEBHOOK_SECRET="replace_with_webhook_signing_secret"

# Create six Razorpay Plans before enabling checkout. Set each interval to one
# month/year and use the exact INR amount shown here:
# Starter monthly 999 (99900 paise), annual 9990 (999000 paise)
# Growth monthly 2499 (249900 paise), annual 24990 (2499000 paise)
# Scale monthly 5999 (599900 paise), annual 59990 (5999000 paise)
# Copy each returned plan_... identifier from the Test Mode dashboard.
RAZORPAY_PLAN_STARTER_MONTHLY="plan_replace_starter_monthly"
RAZORPAY_PLAN_STARTER_ANNUAL="plan_replace_starter_annual"
RAZORPAY_PLAN_GROWTH_MONTHLY="plan_replace_growth_monthly"
RAZORPAY_PLAN_GROWTH_ANNUAL="plan_replace_growth_annual"
RAZORPAY_PLAN_SCALE_MONTHLY="plan_replace_scale_monthly"
RAZORPAY_PLAN_SCALE_ANNUAL="plan_replace_scale_annual"

# Do not put RAZORPAY_KEY_SECRET or RAZORPAY_WEBHOOK_SECRET in Expo variables.
# Configure backend webhook URL:
# https://<backend-host>/api/v1/subscriptions/webhooks/razorpay
# Subscribe to payment.captured, payment.failed, payment.authorized,
# subscription.activated, subscription.charged, subscription.halted,
# subscription.paused, subscription.resumed, subscription.cancelled,
# subscription.authenticated, subscription.pending, subscription.completed,
# subscription.expired and subscription.updated.

# Safety switches (see docs report, section 8/13):
# Refuse rzp_live_ keys even when NODE_ENV=production (set on the Render TESTING service).
RAZORPAY_ENFORCE_TEST_MODE=true
# Legacy only: allow tenants that have NO subscription row. Default (unset) is fail-closed.
# Never enable for new environments.
# ALLOW_LEGACY_TENANTS_WITHOUT_SUBSCRIPTION=true
