generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ======================================================
// ENUMS
// ======================================================

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum SubscriptionStatus {
  PENDING_ACTIVATION
  ACTIVE
  EXPIRED
  CANCELLED
}

// ======================================================
// TENANT
// ======================================================

model Tenant {
  id     String       @id @default(uuid())
  name   String
  status RecordStatus @default(ACTIVE)

  companies Company[]
  users     User[]

  subscription BusinessSubscription?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ======================================================
// COMPANY
// ======================================================

model Company {
  id       String @id @default(uuid())
  tenantId String
  name     String

  status RecordStatus @default(ACTIVE)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branches Branch[]

  userAccess UserCompanyAccess[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

// ======================================================
// BRANCH
// ======================================================

model Branch {
  id        String @id @default(uuid())
  companyId String
  name      String

  status RecordStatus @default(ACTIVE)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  userAccess UserBranchAccess[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

// ======================================================
// USER
// ======================================================

model User {
  id       String  @id @default(uuid())
  tenantId String?

  name     String
  email    String  @unique
  password String
  phone    String?

  status UserStatus @default(ACTIVE)

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  roles         UserRole[]
  companyAccess UserCompanyAccess[]
  branchAccess  UserBranchAccess[]

  // Password reset tokens issued to this user
  passwordResetTokens PasswordResetToken[]

  // Used to invalidate old JWTs after password changes
  tokenVersion Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

// ======================================================
// ROLE
// ======================================================

model Role {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  users       UserRole[]
  permissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ======================================================
// PERMISSION
// ======================================================

model Permission {
  id          String  @id @default(uuid())
  key         String  @unique
  name        String
  description String?

  roles RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ======================================================
// USER ROLES
// ======================================================

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([userId, roleId])
  @@index([roleId])
}

// ======================================================
// ROLE PERMISSIONS
// ======================================================

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([roleId, permissionId])
  @@index([permissionId])
}

// ======================================================
// USER COMPANY ACCESS
// ======================================================

model UserCompanyAccess {
  userId    String
  companyId String

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([userId, companyId])
  @@index([companyId])
}

// ======================================================
// USER BRANCH ACCESS
// ======================================================

model UserBranchAccess {
  userId   String
  branchId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([userId, branchId])
  @@index([branchId])
}

// ======================================================
// BUSINESS SUBSCRIPTION
// ======================================================

model BusinessSubscription {
  id       String @id @default(uuid())
  tenantId String @unique

  // Selected subscription plan
  // Allowed values validated by backend DTO:
  // starter, growth, scale
  planId String

  // monthly or annual
  billingCycle String

  // Signup does not automatically activate billing
  status SubscriptionStatus @default(PENDING_ACTIVATION)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// ======================================================
// PASSWORD RESET TOKENS
// ======================================================

model PasswordResetToken {
  id String @id @default(uuid())

  // User requesting the password reset
  userId String

  // SHA-256 hash of the generated reset token.
  // Never store the original token in the database.
  tokenHash String @unique

  // Reset link expiration time
  expiresAt DateTime

  // Set when the token is successfully consumed
  usedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}
