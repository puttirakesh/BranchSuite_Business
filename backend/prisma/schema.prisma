generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

// ======================================================
// ENUMS
// ======================================================

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum SubscriptionStatus {
  PENDING_ACTIVATION
  ACTIVE
  EXPIRED
  CANCELLED
}

enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum ActivityType {
  CALL
  MEETING
  EMAIL
  TASK
  FOLLOW_UP
}

enum ActivityStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  ON_LEAVE
}

enum AttendanceCorrectionStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum AttendanceSource {
  SELF
  MANUAL
  SYSTEM
}

// ======================================================
// LEAVE MANAGEMENT ENUMS
// ======================================================

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum SalaryComponentKind {
  EARNING
  DEDUCTION
}

// ======================================================
// PAYROLL ENUMS
// ======================================================

enum PayrollStatus {
  DRAFT
  CALCULATED
  APPROVED
  PAID
}

enum PayrollPaymentMethod {
  BANK_TRANSFER
  CASH
  UPI
  OTHER
}

// ======================================================
// CONFIGURABLE PAYROLL POLICY ENUMS
// ======================================================

enum PayrollCalculationMode {
  FIXED
  ATTENDANCE_BASED
}

enum PayrollDayBasis {
  CALENDAR_DAYS
}

enum MissingAttendanceAction {
  BLOCK_CALCULATION
}

// ======================================================
// TASK MANAGEMENT ENUMS
// ======================================================

enum TaskStatus {
  TODO
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum SalaryAdvanceStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// ======================================================
// TENANT
// ======================================================

model Tenant {
  departments Department[]
  deals  Deal[]
  id     String       @id @default(uuid())
  name   String
  status RecordStatus @default(ACTIVE)

  companies Company[]
  users     User[]

  subscription BusinessSubscription?

  // CRM
  customers Customer[]
  leads     Lead[]

  // Attendance
  attendances                  Attendance[]
  attendanceCorrectionRequests AttendanceCorrectionRequest[]

  salaryAdvances SalaryAdvance[]

  // Leave management
  leaveTypes    LeaveType[]
  leaveRequests LeaveRequest[]
  leaveBalances LeaveBalance[]

  // Payroll
  salaryStructures SalaryStructure[]
  salaryComponents SalaryComponent[]
  employeeSalaries EmployeeSalary[]
  payrollPeriods   PayrollPeriod[]
  payrollRuns      PayrollRun[]

  // Configurable payroll policies
  payrollPolicies CompanyPayrollPolicy[]

  // Employee management
  employeeProfiles EmployeeProfile[]

  // CRM activities
  crmActivities CrmActivity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks        Task[]
  taskComments TaskComment[]
}

// ======================================================
// COMPANY
// ======================================================

model Company {
  payslipSettings Json?
  payslipSettingsVersion Int @default(1)
  payrollCalendar Json?
  departments Department[]
  employeeIdPrefix String @default("EMP")
  employeeIdDigits Int    @default(3)
  employeeIdNext   Int    @default(1)
  deals            Deal[]
  id               String @id @default(uuid())
  tenantId         String
  name             String

  status RecordStatus @default(ACTIVE)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branches Branch[]

  userAccess           UserCompanyAccess[]
  workspacePreferences UserWorkspacePreference[]

  // CRM
  customers     Customer[]
  leads         Lead[]
  crmActivities CrmActivity[]

  // Attendance
  attendances                  Attendance[]
  attendanceCorrectionRequests AttendanceCorrectionRequest[]

  salaryAdvances SalaryAdvance[]

  // Leave management
  leaveTypes    LeaveType[]
  leaveRequests LeaveRequest[]
  leaveBalances LeaveBalance[]

  // Payroll
  salaryStructures SalaryStructure[]
  salaryComponents SalaryComponent[]
  employeeSalaries EmployeeSalary[]
  payrollPeriods   PayrollPeriod[]
  payrollRuns      PayrollRun[]

  // Configurable payroll policies
  payrollPolicies CompanyPayrollPolicy[]

  // Employee management
  employeeProfiles EmployeeProfile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks        Task[]
  taskComments TaskComment[]

  @@index([tenantId])
}

// ======================================================
// BRANCH
// ======================================================

model Branch {
  departments Department[]
  deals         Deal[]
  id            String  @id @default(uuid())
  companyId     String
  name          String
  code          String  @db.VarChar(20)
  location      String  @default("") @db.VarChar(240)
  manager       String  @default("") @db.VarChar(150)
  managerUserId String?

  status RecordStatus @default(ACTIVE)

  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  managerUser User?   @relation("BranchManager", fields: [managerUserId], references: [id], onDelete: SetNull)

  userAccess UserBranchAccess[]

  // CRM
  customers     Customer[]
  leads         Lead[]
  crmActivities CrmActivity[]

  // Attendance
  attendances                  Attendance[]
  attendanceCorrectionRequests AttendanceCorrectionRequest[]

  // Leave management
  leaveRequests LeaveRequest[]

  salaryAdvances SalaryAdvance[]

  // Payroll
  employeeSalaries EmployeeSalary[]
  payrollPeriods   PayrollPeriod[]
  payrollRuns      PayrollRun[]

  // Employee management
  employeeProfiles EmployeeProfile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks        Task[]
  taskComments TaskComment[]

  @@index([managerUserId])
  @@index([companyId])
}

// ======================================================
// USER
// ======================================================

model Department {
  id             String   @id @default(uuid())
  tenantId       String
  companyId      String
  branchId       String?
  name           String   @db.VarChar(100)
  normalizedName String   @db.VarChar(100)
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch         Branch?  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([companyId, branchId, normalizedName])
  @@index([tenantId, companyId])
}

model User {
  ownedDeals Deal[]  @relation("DealOwner")
  id         String  @id @default(uuid())
  tenantId   String?

  name     String
  email    String  @unique
  password String
  phone    String?

  status UserStatus @default(ACTIVE)

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  roles                UserRole[]
  companyAccess        UserCompanyAccess[]
  branchAccess         UserBranchAccess[]
  managedBranches      Branch[]                  @relation("BranchManager")
  workspacePreferences UserWorkspacePreference[]

  passwordResetTokens PasswordResetToken[]

  tokenVersion Int @default(0)

  // CRM customers
  createdCustomers Customer[] @relation("CustomerCreatedBy")

  // CRM leads
  createdLeads  Lead[] @relation("LeadCreatedBy")
  assignedLeads Lead[] @relation("LeadAssignedTo")

  // CRM activities
  createdCrmActivities  CrmActivity[] @relation("CrmActivityCreatedBy")
  assignedCrmActivities CrmActivity[] @relation("CrmActivityAssignedTo")

  // Attendance
  employeeAttendances Attendance[] @relation("EmployeeAttendance")
  markedAttendances   Attendance[] @relation("AttendanceMarkedBy")

  attendanceCorrectionsRequested AttendanceCorrectionRequest[] @relation("AttendanceCorrectionRequestedBy")
  attendanceCorrectionsReviewed  AttendanceCorrectionRequest[] @relation("AttendanceCorrectionReviewedBy")

  // Leave management
  leaveRequests         LeaveRequest[] @relation("LeaveRequestedBy")
  reviewedLeaveRequests LeaveRequest[] @relation("LeaveReviewedBy")
  reportingLeaveRequests LeaveRequest[] @relation("LeaveReportingTo")
  leaveBalances         LeaveBalance[]

  // Payroll
  employeeSalaries        EmployeeSalary[]
  payrollEntries          PayrollEntry[]
  payrollRunsCreated      PayrollRun[]     @relation("PayrollRunCreatedBy")
  payrollRunsApproved     PayrollRun[]     @relation("PayrollRunApprovedBy")
  payrollPaymentsRecorded PayrollPayment[] @relation("PayrollPaymentRecordedBy")

  // Employee management
  employeeProfiles EmployeeProfile[]

  // Audit fields
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasksCreated  Task[]        @relation("TaskCreatedBy")
  tasksAssigned Task[]        @relation("TaskAssignedTo")
  taskComments  TaskComment[]

  salaryAdvancesRequested SalaryAdvance[] @relation("SalaryAdvanceRequestedBy")
  salaryAdvancesReviewed  SalaryAdvance[] @relation("SalaryAdvanceReviewedBy")

  @@index([tenantId])
}

// ======================================================
// ROLE
// ======================================================

model Role {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  users       UserRole[]
  permissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ======================================================
// PERMISSION
// ======================================================

model Permission {
  id          String  @id @default(uuid())
  key         String  @unique
  name        String
  description String?

  roles RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ======================================================
// USER ROLES
// ======================================================

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([userId, roleId])
  @@index([roleId])
}

// ======================================================
// ROLE PERMISSIONS
// ======================================================

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([roleId, permissionId])
  @@index([permissionId])
}

// ======================================================
// USER COMPANY ACCESS
// ======================================================

model UserCompanyAccess {
  userId      String
  companyId   String
  grantSource String @default("MANUAL") @db.VarChar(20)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([userId, companyId])
  @@index([companyId])
}

// ======================================================
// USER BRANCH ACCESS
// ======================================================

model UserBranchAccess {
  userId      String
  branchId    String
  grantSource String @default("MANUAL") @db.VarChar(20)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([userId, branchId])
  @@index([branchId])
}

model UserWorkspacePreference {
  id        String   @id @default(uuid())
  userId    String
  companyId String
  key       String   @db.VarChar(40)
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId, key])
  @@index([companyId, key])
}

// ======================================================
// BUSINESS SUBSCRIPTION
// ======================================================

model BusinessSubscription {
  id       String @id @default(uuid())
  tenantId String @unique

  planId       String
  billingCycle String

  status SubscriptionStatus @default(PENDING_ACTIVATION)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// ======================================================
// PASSWORD RESET TOKENS
// ======================================================

model PasswordResetToken {
  id String @id @default(uuid())

  userId String

  tokenHash String @unique

  expiresAt DateTime
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ======================================================
// CRM CUSTOMER
// ======================================================

model Customer {
  deals         Deal[]
  convertedLead Lead?  @relation("LeadConversion")
  id            String @id @default(uuid())

  tenantId  String
  companyId String
  branchId  String?

  name    String
  email   String?
  phone   String?
  address String?
  notes   String?

  status RecordStatus @default(ACTIVE)

  createdById String

  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch    Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdBy User    @relation("CustomerCreatedBy", fields: [createdById], references: [id])

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  crmActivities CrmActivity[]

  @@index([tenantId])
  @@index([companyId])
  @@index([branchId])
  @@index([createdById])
  @@index([tenantId, companyId, status])
}

// ======================================================
// CRM LEAD
// ======================================================

model Lead {
  deals               Deal[]
  convertedCustomerId String?   @unique
  convertedCustomer   Customer? @relation("LeadConversion", fields: [convertedCustomerId], references: [id], onDelete: SetNull)
  id                  String    @id @default(uuid())

  tenantId  String
  companyId String
  branchId  String?

  name                String
  contactPerson       String?
  source              String?
  estimatedValue      Decimal? @db.Decimal(18, 2)
  assignedEmployeeIds String[] @default([])
  email               String?
  phone               String?
  address             String?
  notes               String?

  stage LeadStage @default(NEW)

  createdById String

  assignedToId String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  createdBy User @relation("LeadCreatedBy", fields: [createdById], references: [id])

  assignedTo User? @relation("LeadAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  crmActivities CrmActivity[]

  @@index([tenantId])
  @@index([companyId])
  @@index([branchId])
  @@index([createdById])
  @@index([assignedToId])
  @@index([tenantId, companyId, stage])
}

// ======================================================
// CRM ACTIVITIES
// ======================================================

model CrmActivity {
  id String @id @default(uuid())

  tenantId  String
  companyId String
  branchId  String?

  leadId     String?
  customerId String?

  title       String
  description String?

  type   ActivityType
  status ActivityStatus @default(PENDING)

  scheduledAt DateTime
  completedAt DateTime?

  createdById  String
  assignedToId String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  lead Lead? @relation(fields: [leadId], references: [id], onDelete: SetNull)

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  createdBy User @relation("CrmActivityCreatedBy", fields: [createdById], references: [id])

  assignedTo User? @relation("CrmActivityAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([companyId])
  @@index([branchId])
  @@index([leadId])
  @@index([customerId])
  @@index([assignedToId])
  @@index([tenantId, status, scheduledAt])
}

// ======================================================
// ATTENDANCE
// ======================================================

model Attendance {
  id String @id @default(uuid())

  tenantId  String
  companyId String
  branchId  String
  userId    String

  attendanceDate DateTime @db.Date

  checkInAt  DateTime?
  checkOutAt DateTime?

  status AttendanceStatus @default(PRESENT)
  source AttendanceSource @default(SELF)

  totalMinutes Int @default(0)
  lateMinutes  Int @default(0)

  notes String?

  markedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  user User @relation("EmployeeAttendance", fields: [userId], references: [id], onDelete: Cascade)

  markedBy User? @relation("AttendanceMarkedBy", fields: [markedById], references: [id], onDelete: SetNull)

  // Attendance correction requests
  correctionRequests AttendanceCorrectionRequest[]

  @@unique([tenantId, companyId, branchId, userId, attendanceDate])
  @@index([tenantId, attendanceDate])
  @@index([companyId, attendanceDate])
  @@index([branchId, attendanceDate])
  @@index([userId, attendanceDate])
  @@index([status])
}

// ======================================================
// ATTENDANCE CORRECTION REQUESTS
// ======================================================

model AttendanceCorrectionRequest {
  id String @id @default(uuid())

  tenantId     String
  companyId    String
  branchId     String
  userId       String
  attendanceId String

  requestedCheckInAt  DateTime
  requestedCheckOutAt DateTime

  reason String

  status AttendanceCorrectionStatus @default(PENDING)

  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch     Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  attendance Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)

  requestedBy User  @relation("AttendanceCorrectionRequestedBy", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy  User? @relation("AttendanceCorrectionReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  // Indexes
  @@index([tenantId, companyId, branchId, status])
  @@index([userId, createdAt])
  @@index([attendanceId, status])
}

// ======================================================
// LEAVE TYPES (PER COMPANY)
// ======================================================

model LeaveType {
  id String @id @default(uuid())

  tenantId  String
  companyId String

  code            String
  name            String
  isPaid          Boolean      @default(true)
  annualAllowance Int          @default(0)
  status          RecordStatus @default(ACTIVE)

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company  Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  requests LeaveRequest[]
  balances LeaveBalance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, code])
  @@index([tenantId, companyId])
}

// ======================================================
// LEAVE REQUESTS
// ======================================================

model LeaveRequest {
  id String @id @default(uuid())

  tenantId    String
  companyId   String
  branchId    String
  userId      String
  leaveTypeId String

  startDate DateTime           @db.Date
  endDate   DateTime           @db.Date
  days      Int
  reason    String
  status    LeaveRequestStatus @default(PENDING)

  reviewedById String?
  reportingToId String?
  reviewedAt   DateTime?
  reviewNote   String?

  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch     Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  user       User      @relation("LeaveRequestedBy", fields: [userId], references: [id], onDelete: Cascade)
  leaveType  LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  reviewedBy User?     @relation("LeaveReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reportingTo User?    @relation("LeaveReportingTo", fields: [reportingToId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, companyId, branchId, status])
  @@index([userId, startDate, endDate])
  @@index([leaveTypeId])
  @@index([reportingToId])
}

// ======================================================
// YEARLY LEAVE BALANCES
// ======================================================

model LeaveBalance {
  id String @id @default(uuid())

  tenantId    String
  companyId   String
  userId      String
  leaveTypeId String
  year        Int

  allocatedDays Int @default(0)
  usedDays      Int @default(0)

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, leaveTypeId, year])
  @@index([tenantId, companyId, year])
  @@index([userId, year])
}

// ======================================================
// PAYROLL: SALARY STRUCTURES
// ======================================================

model SalaryStructure {
  id          String            @id @default(uuid())
  tenantId    String
  companyId   String
  name        String
  currency    String            @default("INR")
  basicAmount Decimal           @db.Decimal(14, 2)
  status      RecordStatus      @default(ACTIVE)
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company     Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  components  SalaryComponent[]
  assignments EmployeeSalary[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([companyId, name])
  @@index([tenantId, companyId])
}

// ======================================================
// PAYROLL: SALARY COMPONENTS
// ======================================================

model SalaryComponent {
  id          String              @id @default(uuid())
  tenantId    String
  companyId   String
  structureId String
  code        String
  name        String
  kind        SalaryComponentKind
  amount      Decimal             @db.Decimal(14, 2)
  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company     Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  structure   SalaryStructure     @relation(fields: [structureId], references: [id], onDelete: Cascade)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([structureId, code])
  @@index([tenantId, companyId])
}

// ======================================================
// PAYROLL: EMPLOYEE SALARY ASSIGNMENTS
// ======================================================

model EmployeeSalary {
  id             String          @id @default(uuid())
  tenantId       String
  companyId      String
  branchId       String
  userId         String
  structureId    String
  effectiveFrom  DateTime        @db.Date
  effectiveTo    DateTime?       @db.Date
  basicOverride  Decimal?        @db.Decimal(14, 2)
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch         Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  structure      SalaryStructure @relation(fields: [structureId], references: [id], onDelete: Restrict)
  payrollEntries PayrollEntry[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([companyId, branchId, userId, effectiveFrom])
  @@index([tenantId, companyId, branchId])
  @@index([userId, effectiveFrom])
}

// ======================================================
// PAYROLL: MONTHLY PERIODS
// ======================================================

model PayrollPeriod {
  id        String      @id @default(uuid())
  tenantId  String
  companyId String
  branchId  String
  year      Int
  month     Int
  startDate DateTime    @db.Date
  endDate   DateTime    @db.Date
  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company   Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch    Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  run       PayrollRun?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([companyId, branchId, year, month])
  @@index([tenantId, companyId, branchId])
}

// ======================================================
// PAYROLL: RUNS
// ======================================================

model PayrollRun {
  id           String        @id @default(uuid())
  tenantId     String
  companyId    String
  branchId     String
  periodId     String        @unique
  status       PayrollStatus @default(DRAFT)
  createdById  String
  approvedById String?

  // Policy applied when this payroll was calculated.
  // Nullable for payroll runs created before this feature.

  policyIdSnapshot       String?
  policyVersionSnapshot  Int?
  policyModeSnapshot     PayrollCalculationMode?
  policySettingsSnapshot Json?
  policySnapshotAt       DateTime?

  calculatedAt    DateTime?
  approvedAt      DateTime?
  // Separate publication: approved figures are not employee-visible until published.
  publishedAt     DateTime?
  publishedById   String?
  paidAt          DateTime?
  grossTotal      Decimal        @default(0) @db.Decimal(16, 2)
  deductionsTotal Decimal        @default(0) @db.Decimal(16, 2)
  netTotal        Decimal        @default(0) @db.Decimal(16, 2)
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company         Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch          Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  period          PayrollPeriod  @relation(fields: [periodId], references: [id], onDelete: Cascade)
  createdBy       User           @relation("PayrollRunCreatedBy", fields: [createdById], references: [id])
  approvedBy      User?          @relation("PayrollRunApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  entries         PayrollEntry[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([tenantId, companyId, branchId, status])
}

// ======================================================
// PAYROLL: ENTRY SNAPSHOTS
// ======================================================

model PayrollEntry {
  identitySnapshot Json?
  paidDays Decimal? @db.Decimal(6, 2)
  periodDays Int?
  advanceRecoveries PayrollAdvanceRecovery[]
  id               String                  @id @default(uuid())
  runId            String
  userId           String
  employeeSalaryId String?
  currency         String
  basicAmount      Decimal                 @db.Decimal(14, 2)
  grossAmount      Decimal                 @db.Decimal(14, 2)
  deductionsAmount Decimal                 @db.Decimal(14, 2)
  netAmount        Decimal                 @db.Decimal(14, 2)
  run              PayrollRun              @relation(fields: [runId], references: [id], onDelete: Cascade)
  user             User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeSalary   EmployeeSalary?         @relation(fields: [employeeSalaryId], references: [id], onDelete: SetNull)
  components       PayrollEntryComponent[]
  payment          PayrollPayment?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@unique([runId, userId])
  @@index([userId])
}

// ======================================================
// PAYROLL: ENTRY COMPONENT SNAPSHOTS
// ======================================================

model PayrollEntryComponent {
  id      String              @id @default(uuid())
  entryId String
  code    String
  name    String
  kind    SalaryComponentKind
  amount  Decimal             @db.Decimal(14, 2)
  entry   PayrollEntry        @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([entryId, code])
}

// ======================================================
// PAYROLL: PAYMENTS
// ======================================================

model PayrollPayment {
  id           String               @id @default(uuid())
  entryId      String               @unique
  amount       Decimal              @db.Decimal(14, 2)
  method       PayrollPaymentMethod
  reference    String?
  paidAt       DateTime             @default(now())
  recordedById String
  entry        PayrollEntry         @relation(fields: [entryId], references: [id], onDelete: Restrict)
  recordedBy   User                 @relation("PayrollPaymentRecordedBy", fields: [recordedById], references: [id])
  createdAt    DateTime             @default(now())

  @@index([recordedById])
}

// ======================================================
// EMPLOYEE MANAGEMENT
// ======================================================

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

enum EmploymentStatus {
  ACTIVE
  INACTIVE
  EXITED
}

model EmployeeProfile {
  bankName String?
  bankEnding String? @db.VarChar(4)
  bankIfsc String? @db.VarChar(11)
  pan String? @db.VarChar(10)
  uan String? @db.VarChar(12)
  id             String           @id @default(uuid())
  tenantId       String
  companyId      String
  branchId       String
  userId         String
  employeeCode   String
  department     String?
  designation    String?
  employmentType EmploymentType   @default(FULL_TIME)
  status         EmploymentStatus @default(ACTIVE)
  joiningDate    DateTime         @db.Date
  exitDate       DateTime?        @db.Date
  workEmail      String?
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Restrict)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([companyId, userId])
  @@unique([companyId, employeeCode])
  @@index([tenantId, companyId, branchId, status])
  @@index([userId])
}

// ======================================================
// CONFIGURABLE COMPANY PAYROLL POLICIES
// ======================================================

model CompanyPayrollPolicy {
  id        String @id @default(uuid())
  tenantId  String
  companyId String

  // Fixed salary is the default.
  mode PayrollCalculationMode @default(FIXED)

  // Calendar days: 28, 29, 30 or 31.
  dayBasis PayrollDayBasis @default(CALENDAR_DAYS)

  // In attendance-based mode, unresolved dates
  // must block payroll calculation.
  missingAttendanceAction MissingAttendanceAction @default(BLOCK_CALCULATION)

  // HALF_DAY contributes 0.50 unpaid day.
  halfDayDeduction Decimal @default(0.50) @db.Decimal(3, 2)

  // Attendance-related deduction configuration.
  deductUnpaidLeave Boolean @default(true)
  deductAbsentDays  Boolean @default(true)

  // Version effective dates.
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date

  // Historical policy revision.
  version Int @default(1)

  // Tenant and company ownership.
  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, version])
  @@index([tenantId, companyId, effectiveFrom])
}

model Task {
  id        String @id @default(uuid())
  tenantId  String
  companyId String
  branchId  String

  title       String
  description String?
  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(TODO)

  assignedToId String
  createdById  String

  dueDate     DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  assignedTo User @relation("TaskAssignedTo", fields: [assignedToId], references: [id], onDelete: Restrict)
  createdBy  User @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  comments TaskComment[]

  @@index([tenantId, companyId, branchId, status])
  @@index([assignedToId, status, dueDate])
  @@index([createdById])
  @@index([dueDate])
}

model TaskComment {
  id        String @id @default(uuid())
  taskId    String
  tenantId  String
  companyId String
  branchId  String
  userId    String

  message   String
  createdAt DateTime @default(now())

  task    Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([taskId, createdAt])
  @@index([tenantId, companyId, branchId])
}

// ======================================================
// SALARY ADVANCES
// ======================================================

model SalaryAdvance {
  disbursedAt DateTime?
  disbursedById String?
  paymentReference String?
  recoveryMonthly Decimal? @db.Decimal(14, 2)
  recoveryStart String? @db.VarChar(7)
  recoveries PayrollAdvanceRecovery[]
  id        String @id @default(uuid())
  tenantId  String
  companyId String
  branchId  String
  userId    String

  amount Decimal @db.Decimal(14, 2)
  reason String  @db.VarChar(1000)

  status SalaryAdvanceStatus @default(PENDING)

  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?   @db.VarChar(1000)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  tenant     Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch     Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  employee   User    @relation("SalaryAdvanceRequestedBy", fields: [userId], references: [id], onDelete: Restrict)
  reviewedBy User?   @relation("SalaryAdvanceReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([tenantId, companyId, branchId, status])
  @@index([userId, createdAt])
  @@index([reviewedById])
}

// Append-only application audit events. No public mutation endpoints.
model AuditEvent {
  id        String   @id @default(uuid())
  tenantId  String
  companyId String?
  branchId  String?
  actorId   String
  action    String   @db.VarChar(100)
  module    String   @db.VarChar(60)
  targetId  String   @db.VarChar(100)
  detail    String   @default("") @db.VarChar(500)
  changes   Json?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, companyId, createdAt])
  @@index([tenantId, branchId, createdAt])
  @@index([tenantId, module, createdAt])
}

model Deal {
  quotes          Quote[]
  id              String    @id @default(uuid())
  tenantId        String
  companyId       String
  branchId        String?
  leadId          String?
  customerId      String?
  ownerId         String
  title           String
  amount          Decimal?  @db.Decimal(18, 2)
  currency        String    @default("INR") @db.VarChar(3)
  stage           String    @default("DISCOVERY")
  expectedCloseAt DateTime?
  closedAt        DateTime?
  lossReason      String?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company      Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch       Branch?            @relation(fields: [branchId], references: [id], onDelete: SetNull)
  lead         Lead?              @relation(fields: [leadId], references: [id], onDelete: SetNull)
  customer     Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  owner        User               @relation("DealOwner", fields: [ownerId], references: [id])
  stageHistory DealStageHistory[]

  @@index([tenantId, companyId, branchId, stage])
  @@index([tenantId, ownerId, stage])
  @@index([leadId])
  @@index([customerId])
}

model DealStageHistory {
  id          String   @id @default(uuid())
  dealId      String
  tenantId    String
  fromStage   String
  toStage     String
  changedById String
  reason      String?
  createdAt   DateTime @default(now())

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId, createdAt])
  @@index([tenantId, createdAt])
}

// Server-backed CRM quotations; never overwrite delivered quotes in place.
model Quote {
  id          String      @id @default(uuid())
  tenantId    String
  companyId   String
  branchId    String?
  dealId      String
  createdById String
  title       String
  notes       String?
  currency    String      @default("INR") @db.VarChar(3)
  total       Decimal     @db.Decimal(18, 2)
  status      String      @default("DRAFT")
  version     Int         @default(1)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deal        Deal        @relation(fields: [dealId], references: [id], onDelete: Restrict)
  items       QuoteItem[]

  @@index([tenantId, companyId, branchId])
  @@index([dealId, createdAt])
}

model QuoteItem {
  id          String  @id @default(uuid())
  quoteId     String
  position    Int
  description String
  quantity    Int
  unitPrice   Decimal @db.Decimal(18, 2)
  lineTotal   Decimal @db.Decimal(18, 2)
  quote       Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@unique([quoteId, position])
}

model EmployeeDocument {
  id          String   @id @default(uuid())
  tenantId    String
  companyId   String
  branchId    String
  employeeId  String
  createdById String
  title       String   @db.VarChar(180)
  kind        String   @db.VarChar(40)
  content     String?  @db.Text
  fileName    String?  @db.VarChar(255)
  mimeType    String?  @db.VarChar(100)
  fileSize    Int?
  fileData    Bytes?   @db.ByteA
  status      String   @default("VERIFIED") @db.VarChar(30)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, companyId, employeeId, createdAt])
}

model SupportTicket {
  id          String                 @id @default(uuid())
  tenantId    String
  companyId   String
  branchId    String?
  createdById String
  subject     String                 @db.VarChar(180)
  category    String                 @db.VarChar(40)
  status      String                 @default("OPEN") @db.VarChar(30)
  priority    String                 @default("NORMAL") @db.VarChar(20)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  messages    SupportTicketMessage[]

  @@index([tenantId, companyId, status, updatedAt])
  @@index([createdById, createdAt])
}

model SupportTicketMessage {
  id        String        @id @default(uuid())
  ticketId  String
  authorId  String
  message   String        @db.Text
  createdAt DateTime      @default(now())
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

model BillingInvoice {
  id             String    @id @default(uuid())
  tenantId       String
  companyId      String
  subscriptionId String?
  invoiceNumber  String    @unique @db.VarChar(40)
  description    String    @db.VarChar(300)
  amount         Decimal   @db.Decimal(14, 2)
  currency       String    @default("INR") @db.VarChar(3)
  status         String    @default("ISSUED") @db.VarChar(20)
  issuedAt       DateTime  @default(now())
  dueAt          DateTime?
  paidAt         DateTime?
  paymentNote    String?   @db.VarChar(300)
  createdById    String
  updatedAt      DateTime  @updatedAt

  @@index([tenantId, issuedAt])
  @@index([companyId, status, dueAt])
}

model PayrollIncentive {
  id          String   @id @default(uuid())
  tenantId    String
  companyId   String
  branchId    String
  userId      String
  year        Int
  month       Int
  amount      Decimal  @db.Decimal(14, 2)
  description String   @db.VarChar(300)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, companyId, branchId, userId, year, month])
  @@index([tenantId, companyId, branchId, year, month])
}

model LeadHistory {
  id        String   @id @default(uuid())
  tenantId  String
  leadId    String
  actorId   String
  kind      String   @db.VarChar(30)
  note      String   @db.VarChar(1000)
  createdAt DateTime @default(now())

  @@index([tenantId, leadId, createdAt])
}

