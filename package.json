{
    "name": "branchsuite-business-mobile",
    "version": "0.1.0",
    "private": true,
    "main": "expo-router/entry",
    "scripts": {
        "start": "node scripts/start-expo.cjs",
        "start:mobile": "node scripts/start-expo.cjs --go --lan --clear",
        "start:tunnel": "node scripts/start-expo.cjs --go --tunnel --clear",
        "setup:android": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-android.ps1",
        "check:android": "node scripts/start-expo.cjs --check-android",
        "dev": "node scripts/start-expo.cjs",
        "web": "node scripts/start-expo.cjs --web",
        "android": "node scripts/start-expo.cjs --go --android",
        "ios": "expo start --ios",
        "typecheck": "tsc --noEmit",
        "test": "node --import tsx --test --test-isolation=none tests/*.test.ts",
        "export:web": "expo export --platform web",
        "test:e2e": "npm run export:web && node tests/web-smoke.cjs"
    },
    "dependencies": {
        "@react-native-async-storage/async-storage": "^2.2.0",
        "@tanstack/react-query": "^5.0.0",
        "axios": "^1.0.0",
        "expo": "~57.0.0",
        "expo-constants": "~57.0.21",
        "expo-file-system": "~57.0.7",
        "expo-linking": "~57.0.12",
        "expo-print": "~57.0.2",
        "expo-router": "~57.0.0",
        "expo-secure-store": "~57.0.4",
        "expo-sharing": "~57.0.22",
        "react": "19.2.3",
        "react-dom": "19.2.3",
        "react-icons": "^5.7.0",
        "react-native": "0.86.3",
        "react-native-gesture-handler": "~2.32.0",
        "react-native-reanimated": "4.5.1",
        "react-native-safe-area-context": "~5.7.0",
        "react-native-screens": "~4.26.0",
        "react-native-web": "~0.21.0",
        "react-native-worklets": "0.10.1",
        "react-router-dom": "^7.18.4",
        "zod": "^4.0.0"
    },
    "devDependencies": {
        "@playwright/test": "^1.58.0",
        "@types/node": "^24.0.0",
        "@types/react": "~19.2.4",
        "tsx": "^4.20.0",
        "typescript": "~6.0.3"
    }
}
